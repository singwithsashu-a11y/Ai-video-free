# Local Ollama (no API key). Runs on the same machine as the Python backend.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional cloud AI provider; leave blank to avoid using a cloud API.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

MAX_UPLOAD_MB=500

# Optional fine-tuned MJ AI LoRA adapter (adapter files are not committed to Git)
MJ_AI_ADAPTER_PATH=models/mj-ai-lora
MJ_AI_BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
